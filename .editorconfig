root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
max_line_length = 120
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true

# @Composable 은 PascalCase 가 정상 — 표준 function-naming 규칙에서 제외한다.
ktlint_function_naming_ignore_when_annotated_with = Composable

# 시그니처가 120자에 들어가면 한 줄로 합쳐버리는 규칙 — 선언이 읽기 나빠져서 끈다.
ktlint_standard_function-signature = disabled

# 테마 토큰 전파는 CompositionLocal 의 정당한 용례다(MyNoteTheme.colors/textStyles/adaptive).
# compose-rules 가 경계하는 "암묵적 의존"의 전형적 예외라 끈다.
# Android Lint 쪽(ComposeCompositionLocalUsage)은 build-logic 의 AndroidCompose.kt 에서 끈다.
ktlint_compose_compositionlocal-allowlist = disabled

[*.{md,json,yml,yaml}]
indent_size = 2
